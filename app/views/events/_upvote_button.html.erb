<div class="upvote-container" data-event-id="<%= event.id %>">
  <button class="upvote-btn" data-bs-toggle="modal" data-bs-target="#upvoteModal<%= event.id %>">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M7 10l5-5 5 5M7 14l5 5 5-5"/>
    </svg>
    <span class="upvote-count"><%= event.upvote_count %></span>
  </button>
</div>

<!-- Upvote Modal -->
<div class="modal fade" id="upvoteModal<%= event.id %>" tabindex="-1" aria-labelledby="upvoteModalLabel<%= event.id %>" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="upvoteModalLabel<%= event.id %>">Upvote Event</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form class="upvote-form" data-event-id="<%= event.id %>">
          <div class="mb-3">
            <label for="username<%= event.id %>" class="form-label">Username</label>
            <input type="text" class="form-control" id="username<%= event.id %>" name="username" required>
          </div>
          <div class="mb-3">
            <label for="email<%= event.id %>" class="form-label">Email Address</label>
            <input type="email" class="form-control" id="email<%= event.id %>" name="email" required>
            <div class="form-text">We use your email to prevent duplicate votes.</div>
          </div>
          <div class="alert alert-danger d-none error-message"></div>
          <div class="alert alert-success d-none success-message"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary submit-upvote">Submit Upvote</button>
      </div>
    </div>
  </div>
</div>