<%# app/views/events/_upvote_button.html.erb %>

<div class="upvote-container">
  <button class="upvote-btn <%= 'upvoted' if current_user && event.upvoted_by?(current_user) %>" 
          onclick="toggleUpvote(<%= event.id %>, this)"
          data-event-id="<%= event.id %>">
    <span class="upvote-icon">↑</span>
    <span class="upvote-count"><%= event.upvote_count %></span>
  </button>
</div>

<style>
  .upvote-container {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .upvote-btn {
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.3s;
    color: white;
    font-size: 18px;
    font-weight: 600;
  }

  .upvote-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(1.05);
  }

  .upvote-btn.upvoted {
    background: rgba(76, 175, 80, 0.3);
    border-color: rgba(76, 175, 80, 0.5);
  }

  .upvote-icon {
    font-size: 24px;
  }

  .upvote-count {
    font-size: 20px;
    font-weight: 700;
  }
</style>

<script>
  function toggleUpvote(eventId, button) {
    // Prevent double-clicks
    if (button.disabled) return;
    button.disabled = true;
    
    fetch(`/events/${eventId}/upvote`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      }
    })
    .then(response => response.json())
    .then(data => {
      // Toggle upvoted state
      button.classList.toggle('upvoted');
      
      // Update count
      const countElement = button.querySelector('.upvote-count');
      countElement.textContent = data.upvote_count;
      
      button.disabled = false;
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Failed to upvote. Please try again.');
      button.disabled = false;
    });
  }
</script>