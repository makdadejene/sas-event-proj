<div class="container">
  <button class="close-btn" onclick="window.location.href='/'">×</button>
  <h1>Create an event</h1>

  <div class="form-container">
    <%= form_with model: @event, local: true, html: { multipart: true } do |f| %>
      <div class="form-group">
        <%= f.label :title, "Title" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :date, "Date" %>
        <%= f.date_field :date, class: "form-control" %>
      </div>

      <div class="form-group">
      <%= f.label :start_time, "Start Time" %>
      <%= f.time_field :start_time, class: "form-control" %>
      </div>

      <div class="form-group">
      <%= f.label :end_time, "End Time" %>
      <%= f.time_field :end_time, class: "form-control" %>
      </div>

      <div class="form-group">
      <%= f.label :location, "Location" %>
      <%= f.text_field :location, class: "form-control" %>
    </div>

     <div class="form-group">
      <%= f.label :tags, "Tags" %>
      <div style="flex: 1; display: flex; gap: 15px; flex-wrap: wrap; align-items: center;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: white;">
          <%= check_box_tag 'event[tags][]', 'art', false, id: 'tag_art' %>
          <span style="font-size: 18px;">Art</span>
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: white;">
          <%= check_box_tag 'event[tags][]', 'sports', false, id: 'tag_sports' %>
          <span style="font-size: 18px;">Sports</span>
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: white;">
          <%= check_box_tag 'event[tags][]', 'ed', false, id: 'tag_ed' %>
          <span style="font-size: 18px;">Ed</span>
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: white;">
          <%= check_box_tag 'event[tags][]', 'social', false, id: 'tag_social' %>
          <span style="font-size: 18px;">Social</span>
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: white;">
          <%= check_box_tag 'event[tags][]', 'club', false, id: 'tag_club' %>
          <span style="font-size: 18px;">Club</span>
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: white;">
          <%= check_box_tag 'event[tags][]', 'other', false, id: 'tag_other' %>
          <span style="font-size: 18px;">Other</span>
        </label>
      </div>
    </div>

      <div class="form-group">
        <%= f.label :description, "Description" %>
        <%= f.text_area :description, class: "form-control" %>
      </div>

      <div class="form-group upload-container">
  <%= f.label :image, "Upload Image" %>
  
  <!-- label must point to the input ID -->
  <label for="event_image" class="upload-box">
    <svg class="upload-icon" viewBox="0 0 24 24">
      <path d="M12 4v12m0-12l-4 4m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" 
            stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </label>

  <!-- input has to have that matching ID -->
  <%= f.file_field :image, accept: "image/*", id: "event_image", style: "display: none;" %>
</div>

      <div class="button-container">
        <%= f.submit "Submit", class: "submit-btn" %>
      </div>
    <% end %>
  </div>
</div>