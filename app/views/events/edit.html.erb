<!-- app/views/events/edit.html.erb -->
<h1>Edit Event</h1>

<%= form_with(model: @event, local: true) do |f| %>
  <% if @event.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@event.errors.count, "error") %> prohibited this event from being saved:</h2>
      <ul>
        <% @event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :date, "Date" %>
    <%= f.date_field :date %>
  </div>

  <div class="field">
    <%= f.label :start_time, "Start Time" %>
    <%= f.time_field :start_time %>
  </div>

  <div class="field">
    <%= f.label :end_time, "End Time" %>
    <%= f.time_field :end_time %>
  </div>

  <div class="field">
    <%= f.label :location, "Location" %>
    <%= f.text_field :location %>
  </div>

  <div class="field">
    <%= f.label :description, "Description" %>
    <%= f.text_area :description %>
  </div>

  <div class="field">
    <%= f.label :tags, "Tags" %>
    <%= f.select :tags, 
          ["Sports", "Ed", "Social", "Art", "Club", "Other"], 
          {}, 
          { multiple: true, class: "form-control large-select" } %>
  </div>

  <div class="field">
    <%= f.label :unlisted, "Unlisted?" %>
    <%= f.check_box :unlisted %>
  </div>

  <div class="actions">
    <%= f.submit "Update Event" %>
  </div>
<% end %>

<%= link_to "Back", events_path %>
