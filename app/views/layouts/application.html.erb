<!DOCTYPE html>
<html>
  <head>
    <title>Quad</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style>
      * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
      }

      body {
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
          background: linear-gradient(135deg, #8b8b7a 0%, #c9c5b8 100%);
          min-height: 100vh;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 20px;
      }

      .container {
          background: rgba(80, 80, 70, 0.95);
          border-radius: 40px;
          padding: 60px;
          width: 100%;
          max-width: 1400px;
          box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }

      .auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8b8b7a 0%, #c9c5b8 100%);
  color: white;
  padding: 40px 20px;
}

.auth-card {
  background: rgba(50, 50, 45, 0.95);
  border-radius: 40px;
  padding: 80px 100px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  text-align: center;
  max-width: 500px;
  width: 100%;
}

.title {
  font-size: 42px;
  font-weight: 700;
  margin-bottom: 10px;
}

.subtitle {
  font-size: 18px;
  color: #d1d1cc;
  margin-bottom: 50px;
}

.btn-google {
  width: 100%;
  background: #ffffff;
  color: #333;
  border: none;
  border-radius: 12px;
  padding: 18px;
  font-size: 17px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  cursor: pointer;
  transition: background 0.3s;
}

.btn-google::before {
  content: "";
  background: url("https://developers.google.com/identity/images/g-logo.png") no-repeat center;
  background-size: 22px;
  width: 22px;
  height: 22px;
  display: inline-block;
}

.btn-google:hover {
  background: #f3f3f3;
}

@media (max-width: 600px) {
  .auth-card {
    padding: 60px 30px;
    border-radius: 25px;
  }

  .title {
    font-size: 32px;
  }

  .subtitle {
    font-size: 16px;
  }
}


      .top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 60px;
  background: rgba(40, 40, 38, 0.95);
  color: white;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 0 30px;
  z-index: 1000;
  font-size: 18px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20px;
}

.signout-btn {
  background: #e53935;
  border: none;
  color: white;
  padding: 10px 20px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.3s;
}

.signout-btn:hover {
  background: #c62828;
}


      h1 {
          color: white;
          font-size: 64px;
          text-align: center;
          margin-bottom: 50px;
          font-weight: 700;
      }

      .form-container {
          background: rgba(60, 60, 55, 0.9);
          border-radius: 30px;
          padding: 50px;
      }

      .form-group {
          margin-bottom: 30px;
          display: flex;
          align-items: center;
          gap: 30px;
      }

      label {
          color: white;
          font-size: 32px;
          font-weight: 500;
          min-width: 200px;
      }

      input[type="text"],
      input[type="date"],
      input[type="time"],
      textarea {
          background: rgba(40, 40, 38, 0.95);
          border: none;
          border-radius: 15px;
          padding: 20px 25px;
          color: white;
          font-size: 18px;
          flex: 1;
          outline: none;
          transition: background 0.3s;
      }

      input[type="text"]:focus,
      input[type="date"]:focus,
      input[type="time"]:focus,
      textarea:focus {
          background: rgba(50, 50, 48, 0.95);
      }

      textarea {
          min-height: 150px;
          resize: vertical;
          font-family: inherit;
      }

      .upload-container {
          display: flex;
          align-items: center;
          gap: 30px;
      }

      .upload-box {
          background: rgba(40, 40, 38, 0.95);
          border: 3px solid rgba(255, 255, 255, 0.3);
          border-radius: 20px;
          width: 120px;
          height: 120px;
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          transition: all 0.3s;
      }

      .upload-box:hover {
          background: rgba(50, 50, 48, 0.95);
          border-color: rgba(255, 255, 255, 0.5);
      }

      

      .upload-icon {
          width: 60px;
          height: 60px;
          stroke: white;
          stroke-width: 3;
          fill: none;
      }

        

      .large-select {
  width: 100%;
  height: 60px; /* just like your text inputs */
  border: none;
  border-radius: 15px;
  background-color: rgba(40, 40, 38, 0.95);
  color: white;
  padding: 0 20px;
  font-size: 18px;
  font-family: inherit;
  outline: none;
  appearance: none;
  line-height: 60px;
  cursor: pointer;
  transition: background 0.3s;
}

.large-select:focus {
  background: rgba(50, 50, 48, 0.95);
  box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2);
}

.large-select option {
  background-color: rgba(60, 60, 55, 0.95);
  color: white;
  padding: 10px;
}




      input[type="file"] {
          display: none;
      }

      input[type="date"]::-webkit-calendar-picker-indicator,
      input[type="time"]::-webkit-calendar-picker-indicator {
          filter: invert(1);
          cursor: pointer;
      }

      .close-btn {
          position: absolute;
          top: 40px;
          right: 40px;
          background: rgba(255, 255, 255, 0.1);
          border: none;
          border-radius: 50%;
          width: 50px;
          height: 50px;
          color: white;
          font-size: 28px;
          cursor: pointer;
          transition: all 0.3s;
          display: flex;
          align-items: center;
          justify-content: center;
      }

      .close-btn:hover {
          background: rgba(255, 255, 255, 0.2);
          transform: rotate(90deg);
      }

      .submit-btn {
          background: linear-gradient(135deg, #6b6b5a 0%, #8b8b7a 100%);
          border: none;
          border-radius: 15px;
          padding: 20px 60px;
          color: white;
          font-size: 24px;
          font-weight: 600;
          cursor: pointer;
          margin-top: 30px;
          transition: all 0.3s;
          box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      }

      .submit-btn:hover {
          transform: translateY(-2px);
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
      }

      .button-container {
          display: flex;
          justify-content: center;
          margin-top: 40px;
      }
    </style>
  </head>

  <body>
  <header class="top-bar">
  <% if user_signed_in? %>
    <div class="user-info">
      <span>Welcome, <%= current_user.name || current_user.email %></span>
      <%= button_to "Sign out",
                    destroy_user_session_path,
                    method: :delete,
                    data: { turbo: false },
                    class: "signout-btn" %>
    </div>
  <% else %>
    <%= link_to "Sign in",
                new_user_session_path,
                class: "signout-btn" %>
  <% end %>
</header>
  </header>

  <div class="container">
    <%= yield %>
  </div>
</body>

</html>
